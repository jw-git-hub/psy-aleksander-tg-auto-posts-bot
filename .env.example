# Скопируйте этот файл в .env и заполните реальными значениями:
#   cp .env.example .env
#   chmod 600 .env
#
# .env имеет приоритет над config.json (см. load_config() в post_bot.py) —
# удобно для деплоя без хранения секретов в config.json.

# --- Telegram (ОБЯЗАТЕЛЬНО) ---------------------------------------------
# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-bot-token-here

# ID или @username канала, куда бот публикует посты. Бот должен быть
# добавлен в канал как администратор с правом публикации.
TELEGRAM_CHAT_ID=@your_channel_username

# --- Facebook (опционально) ---------------------------------------------
# Если не задано — публикация в Facebook просто пропускается (best-effort,
# см. publishers/facebook.py: is_configured() == False).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- Instagram (опционально) --------------------------------------------
# Instagram Business Account ID. Использует тот же FACEBOOK_PAGE_ACCESS_TOKEN,
# что и Facebook (Graph API). Если не задано — публикация в Instagram
# пропускается без ошибок.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
